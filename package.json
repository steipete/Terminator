{
  "name": "@steipete/terminator-mcp",
  "version": "1.0.0-beta.7",
  "description": "MCP plugin to manage macOS terminal sessions.",
  "keywords": [
    "apple-terminal",
    "iterm2",
    "macos",
    "mcp",
    "terminal",
    "terminal-management"
  ],
  "homepage": "https://github.com/steipete/terminator#readme",
  "bugs": {
    "url": "https://github.com/steipete/terminator/issues"
  },
  "license": "MIT",
  "author": "@steipete",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steipete/terminator.git"
  },
  "bin": {
    "terminator-mcp": "dist/index.js",
    "terminator-mcp-swift": "bin/terminator"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:swift": "./scripts/build-swift-universal.sh",
    "build:ts": "tsgo",
    "typecheck": "tsgo --noEmit",
    "build": "pnpm run build:ts && pnpm run build:swift",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "start": "node dist/index.js",
    "dev": "tsc-watch --onSuccess \"pnpm start\"",
    "clean": "rm -rf dist bin",
    "postinstall": "chmod +x bin/terminator 2>/dev/null || true",
    "prepare-release": "node ./scripts/prepare-release.js",
    "format:swift": "cd cli && swiftformat .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint:swift": "cd cli && swiftlint",
    "lint": "pnpm run format:check && oxlint --deny-warnings src tests scripts",
    "test:swift": "cd cli && swift test",
    "test:applescript": "cd cli/Tests/AppleScriptTests && bash bin/run_apple_terminal_tests.sh",
    "verify:applescript": "node ./scripts/verify-applescript-consistency.js",
    "test:e2e": "vitest run tests/e2e --no-file-parallelism",
    "test": "pnpm run test:e2e",
    "test:watch": "vitest tests/e2e",
    "test:coverage": "vitest run --coverage",
    "inspector": "pnpm dlx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "errno": "^1.0.0",
    "execa": "^9.6.1",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@typescript/native-preview": "7.0.0-dev.20260427.1",
    "@vitest/coverage-v8": "^4.1.8",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "tsc-watch": "^7.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
